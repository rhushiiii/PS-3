# Local development only. Copy to .env at the repository root.
# These are fictional local credentials, not production secrets.
POSTGRES_USER=sih_demo
POSTGRES_PASSWORD=local_demo_only
POSTGRES_DB=sih26263
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://sih_demo:local_demo_only@127.0.0.1:5432/sih26263
# JSON array; allow only the local web origin.
CORS_ORIGINS=["http://localhost:3000"]
# Authentication is disabled by default; never enable demo mode in deployment.
APP_ENV=production
DEMO_AUTH=false
# For local demo only, set APP_ENV=local and DEMO_AUTH=true, then supply a
# separately generated random secret of at least 32 bytes. No default key ships.
DEMO_AUTH_SECRET=
DEMO_TOKEN_TTL_SECONDS=900
# Candidate CSV limits; all uploads remain unvalidated and inactive.
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_ROWS=1000
UPLOAD_RECEIVE_TIMEOUT_SECONDS=30
UPLOAD_PROCESSING_TIMEOUT_SECONDS=30
# Dedicated environment-only HMAC key, >=32 bytes. No default/fallback key.
# Missing/short keys leave health/upload operational but validation returns 422.
APAAR_MATCHING_KEY=
APAAR_FORMAT_LENGTH=12
VALIDATION_INTAKE_RULE_VERSION=DEMO-v1
VALIDATION_PROCESSING_TIMEOUT_SECONDS=30
VALIDATION_MAX_COMPARISON_RECORDS=100000
