# Local development only. Copy to .env at the repository root.
# These are fictional local credentials, not production secrets.
POSTGRES_USER=sih_demo
POSTGRES_PASSWORD=local_demo_only
POSTGRES_DB=sih26263
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://sih_demo:local_demo_only@127.0.0.1:5432/sih26263
# JSON array; allow only the local web origin.
CORS_ORIGINS=["http://localhost:3000"]
# Authentication is disabled by default; never enable demo mode in deployment.
APP_ENV=production
DEMO_AUTH=false
# For local demo only, set APP_ENV=local and DEMO_AUTH=true, then supply a
# separately generated random secret of at least 32 bytes. No default key ships.
DEMO_AUTH_SECRET=
DEMO_TOKEN_TTL_SECONDS=900
# Candidate CSV limits; all uploads remain unvalidated and inactive.
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_ROWS=1000
UPLOAD_RECEIVE_TIMEOUT_SECONDS=30
UPLOAD_PROCESSING_TIMEOUT_SECONDS=30
# Dedicated environment-only HMAC key, >=32 bytes. No default/fallback key.
# Missing/short keys leave health/upload operational but validation returns 422.
APAAR_MATCHING_KEY=
APAAR_FORMAT_LENGTH=12
VALIDATION_INTAKE_RULE_VERSION=DEMO-v1
VALIDATION_PROCESSING_TIMEOUT_SECONDS=30
VALIDATION_MAX_COMPARISON_RECORDS=100000
# Case workflow. CASE_DUE_DAYS_BY_PRIORITY is JSON; due dates are computed at open time.
CASE_DUE_DAYS_BY_PRIORITY={"LOW":30,"MEDIUM":14,"HIGH":7,"URGENT":3}
CASE_ESCALATION_AFTER_DAYS_OVERDUE=7
# Integrity review prompts (rule-based; not fraud or compliance determinations).
INTEGRITY_CHANGE_RATIO_THRESHOLD=0.25
INTEGRITY_REPEATED_CORRECTIONS_THRESHOLD=2
INTEGRITY_STALE_DAYS=90
INTEGRITY_SEVERITY_WEIGHTS={"INFO":0,"LOW":1,"MEDIUM":3,"HIGH":5}
INTEGRITY_BAND_MEDIUM_POINTS=4
INTEGRITY_BAND_HIGH_POINTS=10
# Simulated APAAR provider limits (no government integration is claimed).
APAAR_PROVIDER_TIMEOUT_SECONDS=5
APAAR_MAX_ATTEMPTS_PER_DAY=5
# Signed admission credentials (Ed25519). Base64 of exactly 32 random bytes, e.g.
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# No default key ships; without it issuing returns 422 and verification is UNAVAILABLE.
CREDENTIAL_SIGNING_KEY=
CREDENTIAL_KEY_ID=demo-key-1
CREDENTIAL_ISSUER=PRAVYA-DEMO-ISSUER
CREDENTIAL_TTL_DAYS=365
# Reports and request bounds.
REPORT_MAX_ROWS=10000
REQUEST_MAX_BYTES=1048576
# In-process rate limits (per process; use a shared store for multiple workers).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEMO_LOGIN_PER_MINUTE=10
RATE_LIMIT_UPLOADS_PER_MINUTE=20
RATE_LIMIT_REVIEWS_PER_MINUTE=30
RATE_LIMIT_EXPORTS_PER_MINUTE=10
RATE_LIMIT_CREDENTIALS_PER_MINUTE=30
RATE_LIMIT_VERIFICATION_PER_MINUTE=30
RATE_LIMIT_CASES_PER_MINUTE=60
RATE_LIMIT_INTAKE_PER_MINUTE=30
